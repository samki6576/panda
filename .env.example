# Privy dashboard app ID (public client configuration)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy server authentication
PRIVY_APP_SECRET=

# Neon PostgreSQL connection used by API routes (use the pooled connection string)
DATABASE_URL=postgresql://user:password@your-neon-host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Panta API credentials and base URL
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=
# Optional override for the market creation endpoint
PANTA_MARKETS_PATH=/markets
